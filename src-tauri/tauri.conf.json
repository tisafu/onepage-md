{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "一页",
  "version": "0.3.0-tauri.0",
  "identifier": "cn.workbuddy.onepage",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "一页",
        "width": 1180,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost data: blob: file:; img-src 'self' asset: http://asset.localhost https: data: blob: file:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "role": "Viewer"
      }
    ]
  }
}
